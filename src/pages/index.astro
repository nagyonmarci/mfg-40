---
import Layout from '../layouts/Layout.astro';
const directusUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://api.mfg-art.hu';
---
<Layout title="Feltöltés">
  <div class="upload-page">
    <div class="page-header">
      <h1>Műalkotás feltöltése</h1>
      <p>Töltsd fel alkotásaidat a gimnázium digitális galériájába.</p>
    </div>

    <div id="form-wrap">
      <form id="upload-form">
        <div class="form-group">
          <label for="author">Szerző neve</label>
          <input type="text" id="author" name="author" placeholder="Teljes neved" required />
        </div>
        <div class="form-group">
          <label for="title">Cím</label>
          <input type="text" id="title" name="title" placeholder="Az alkotás neve" required />
        </div>
        <div class="form-group">
          <label for="description">Leírás <span class="opt">(opcionális)</span></label>
          <textarea id="description" name="description" rows="3" placeholder="Rövid leírás..."></textarea>
        </div>
        <div class="form-group">
          <label>Kép</label>
          <div class="drop-zone" id="drop-zone">
            <input type="file" id="file" name="file" accept="image/*" required class="file-input" />
            <div class="drop-content" id="drop-content">
              <div class="drop-icon">⊕</div>
              <div class="drop-text">Húzd ide a képet, vagy kattints</div>
              <div class="drop-hint">JPG, PNG, WEBP — max. 20 MB</div>
            </div>
          </div>
          <div id="preview-wrap" style="display:none;margin-top:0.8rem;position:relative;display:none;">
            <img id="preview-img" src="" alt="Előnézet" style="max-width:100%;max-height:260px;border:1px solid rgba(139,0,0,0.3);" />
            <button type="button" id="remove-file" class="remove-btn">✕</button>
          </div>
        </div>
        <div id="progress-wrap" style="display:none;">
          <div class="progress-bar"><div id="progress-fill" class="progress-fill"></div></div>
          <div id="progress-text" class="progress-text">Feltöltés...</div>
        </div>
        <button type="submit" class="submit-btn" id="submit-btn">Feltöltés</button>
      </form>
    </div>

    <div id="success" class="success" style="display:none;">
      <div class="s-icon">✦</div>
      <h2>Sikeresen feltöltve!</h2>
      <p>Alkotásod megjelent a galériában.</p>
      <div class="s-actions">
        <a href="/galeria" class="btn-red">Megtekintés a galériában</a>
        <button id="upload-another" class="btn-ghost">Újabb feltöltése</button>
      </div>
    </div>

    <div id="error-box" class="error-box" style="display:none;">
      <span id="error-text"></span>
    </div>
  </div>
</Layout>

<style>
  .upload-page { max-width: 620px; margin: 0 auto; }
  .page-header { margin-bottom: 2.5rem; border-left: 3px solid var(--red); padding-left: 1.5rem; }
  h1 { font-family: 'Playfair Display', serif; font-size: 2.4rem; font-weight: 900; line-height: 1.1; margin-bottom: 0.4rem; }
  .page-header p { color: var(--white-dim); font-style: italic; }
  .form-group { margin-bottom: 1.6rem; }
  label { display: block; font-family: 'Playfair Display', serif; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red-bright); margin-bottom: 0.5rem; }
  .opt { color: var(--white-dim); font-family: 'Crimson Pro', serif; text-transform: none; letter-spacing: 0; font-style: italic; font-size: 0.85rem; }
  input[type="text"], textarea {
    width: 100%; background: var(--black-card); border: 1px solid rgba(139,0,0,0.3);
    color: var(--white); padding: 0.85rem 1rem; font-family: 'Crimson Pro', serif; font-size: 1rem;
    outline: none; transition: border-color 0.3s;
  }
  input[type="text"]:focus, textarea:focus { border-color: var(--red-bright); }
  input::placeholder, textarea::placeholder { color: rgba(176,168,152,0.35); }
  textarea { resize: vertical; }
  .drop-zone {
    position: relative; border: 2px dashed rgba(139,0,0,0.4); background: var(--black-card);
    padding: 2.5rem 2rem; text-align: center; cursor: pointer; transition: all 0.3s;
  }
  .drop-zone:hover, .drop-zone.over { border-color: var(--red-bright); background: rgba(139,0,0,0.05); }
  .file-input { position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; }
  .drop-icon { font-size: 2.2rem; color: var(--red-dim); margin-bottom: 0.6rem; }
  .drop-text { color: var(--white-dim); font-size: 0.95rem; }
  .drop-hint { color: rgba(176,168,152,0.45); font-size: 0.78rem; margin-top: 0.4rem; font-style: italic; }
  .remove-btn {
    position: absolute; top: 0.4rem; right: 0.4rem; background: rgba(0,0,0,0.8);
    color: var(--red-bright); border: 1px solid var(--red); padding: 0.25rem 0.55rem;
    cursor: pointer; font-size: 0.72rem;
  }
  .progress-bar { height: 3px; background: rgba(139,0,0,0.2); margin-bottom: 0.5rem; }
  .progress-fill { height: 100%; background: var(--red-bright); width: 0%; transition: width 0.3s; }
  .progress-text { font-size: 0.82rem; color: var(--white-dim); font-style: italic; }
  .submit-btn {
    width: 100%; padding: 1rem; background: var(--red); color: var(--white); border: none;
    font-family: 'Playfair Display', serif; font-size: 0.95rem; letter-spacing: 0.15em;
    text-transform: uppercase; cursor: pointer; transition: background 0.3s; margin-top: 0.3rem;
  }
  .submit-btn:hover:not(:disabled) { background: var(--red-bright); }
  .submit-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .success { text-align: center; padding: 4rem 2rem; animation: fadeUp 0.5s ease; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
  .s-icon { font-size: 2.8rem; color: var(--red-bright); margin-bottom: 1.2rem; }
  .success h2 { font-family: 'Playfair Display', serif; font-size: 1.9rem; margin-bottom: 0.6rem; }
  .success p { color: var(--white-dim); font-style: italic; margin-bottom: 2rem; }
  .s-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
  .btn-red { padding: 0.75rem 1.8rem; background: var(--red); color: var(--white); text-decoration: none; font-family: 'Playfair Display', serif; letter-spacing: 0.1em; font-size: 0.88rem; transition: background 0.3s; }
  .btn-red:hover { background: var(--red-bright); }
  .btn-ghost { padding: 0.75rem 1.8rem; background: transparent; color: var(--white-dim); border: 1px solid rgba(176,168,152,0.3); font-family: 'Playfair Display', serif; letter-spacing: 0.1em; font-size: 0.88rem; cursor: pointer; transition: all 0.3s; }
  .btn-ghost:hover { color: var(--white); border-color: var(--white-dim); }
  .error-box { background: rgba(139,0,0,0.1); border: 1px solid var(--red-dim); padding: 0.9rem 1.2rem; color: #ff7070; margin-top: 1rem; font-style: italic; font-size: 0.95rem; }
</style>

<script define:vars={{ directusUrl }}>
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file');
  const dropContent = document.getElementById('drop-content');
  const previewWrap = document.getElementById('preview-wrap');
  const previewImg = document.getElementById('preview-img');
  const removeBtn = document.getElementById('remove-file');
  const form = document.getElementById('upload-form');
  const submitBtn = document.getElementById('submit-btn');
  const formWrap = document.getElementById('form-wrap');
  const success = document.getElementById('success');
  const errorBox = document.getElementById('error-box');
  const errorText = document.getElementById('error-text');
  const progressWrap = document.getElementById('progress-wrap');
  const progressFill = document.getElementById('progress-fill');
  const progressText = document.getElementById('progress-text');
  const uploadAnother = document.getElementById('upload-another');

  function showPreview(file) {
    if (!file.type.startsWith('image/')) return;
    const reader = new FileReader();
    reader.onload = e => {
      previewImg.src = e.target.result;
      previewWrap.style.display = 'block';
      dropContent.style.display = 'none';
    };
    reader.readAsDataURL(file);
  }

  fileInput.addEventListener('change', () => { if (fileInput.files[0]) showPreview(fileInput.files[0]); });
  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault(); dropZone.classList.remove('over');
    const file = e.dataTransfer?.files[0];
    if (file) { const dt = new DataTransfer(); dt.items.add(file); fileInput.files = dt.files; showPreview(file); }
  });
  removeBtn.addEventListener('click', () => {
    fileInput.value = ''; previewWrap.style.display = 'none'; dropContent.style.display = 'block';
  });

  form.addEventListener('submit', async e => {
    e.preventDefault();
    submitBtn.disabled = true;
    errorBox.style.display = 'none';
    progressWrap.style.display = 'block';
    progressFill.style.width = '10%';
    progressText.textContent = 'Kép feltöltése...';

    try {
      const file = fileInput.files[0];
      if (!file) throw new Error('Válassz ki egy képet.');
      if (file.size > 20 * 1024 * 1024) throw new Error('A fájl mérete meghaladja a 20 MB-ot.');

      // 1. Kép feltöltése a /api/upload proxy-n keresztül
      const imgForm = new FormData();
      imgForm.append('file', file);
      progressFill.style.width = '40%';

      const imgRes = await fetch('/api/upload-image', { method: 'POST', body: imgForm });
      if (!imgRes.ok) {
        const err = await imgRes.json();
        throw new Error(err.error || 'Képfeltöltés sikertelen.');
      }
      const imgData = await imgRes.json();
      const fileId = imgData.id;

      progressFill.style.width = '75%';
      progressText.textContent = 'Adatok mentése...';

      // 2. Artwork bejegyzés létrehozása
      const artRes = await fetch('/api/create-artwork', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          title: document.getElementById('title').value.trim(),
          author: document.getElementById('author').value.trim(),
          description: document.getElementById('description').value.trim(),
          image: fileId
        })
      });
      if (!artRes.ok) {
        const err = await artRes.json();
        throw new Error(err.error || 'Mentés sikertelen.');
      }

      progressFill.style.width = '100%';
      progressText.textContent = 'Kész!';
      setTimeout(() => {
        formWrap.style.display = 'none';
        success.style.display = 'block';
      }, 400);

    } catch (err) {
      errorText.textContent = err.message;
      errorBox.style.display = 'block';
      progressWrap.style.display = 'none';
    } finally {
      submitBtn.disabled = false;
    }
  });

  uploadAnother.addEventListener('click', () => {
    form.reset(); fileInput.value = '';
    previewWrap.style.display = 'none'; dropContent.style.display = 'block';
    progressWrap.style.display = 'none'; progressFill.style.width = '0%';
    success.style.display = 'none'; formWrap.style.display = 'block';
  });
</script>
